//@version=5
strategy("ST33 - SuperTrend + Daily Filter", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ============ Parameters ============
st_period = input.int(10, "SuperTrend Period", minval=1)
st_mult = input.float(3.0, "SuperTrend Multiplier", minval=0.1)
start_hour = input.int(12, "Start Hour (UTC)")
start_minute = input.int(30, "Start Minute (UTC)")
end_hour = input.int(21, "End Hour (UTC)")
end_minute = input.int(0, "End Minute (UTC)")
rr_ratio = input.float(3.0, "Risk:Reward Ratio", minval=1.0)

// ============ SuperTrend Calculation ============
hl2 = (high + low) / 2
atr = ta.atr(st_period)
basic_ub = hl2 + st_mult * atr
basic_lb = hl2 - st_mult * atr

// Calculate final upper/lower bands with trailing logic
var float final_ub = na
var float final_lb = na

final_ub := basic_ub < nz(final_ub, basic_ub) or close[1] > nz(final_ub, basic_ub) ? basic_ub : nz(final_ub, basic_ub)
final_lb := basic_lb > nz(final_lb, basic_lb) or close[1] < nz(final_lb, basic_lb) ? basic_lb : nz(final_lb, basic_lb)

// SuperTrend: closes above upper = downtrend, closes below lower = uptrend
supertrend = close <= final_ub ? final_ub : final_lb
is_uptrend = close > supertrend
flipped_bullish = is_uptrend and not is_uptrend[1]

// ============ Daily Candle Filter ============
daily_close = request.security(syminfo.tickerid, "D", close)
daily_open = request.security(syminfo.tickerid, "D", open)
daily_green = daily_close > daily_open

// ============ Time Filter: 12:30 UTC to 21:00 UTC ============
time_minutes = hour * 60 + minute
start_minutes = start_hour * 60 + start_minute
end_minutes = end_hour * 60 + end_minute
in_session = time_minutes >= start_minutes and time_minutes < end_minutes

// ============ Entry Signal ============
buy_signal = flipped_bullish and daily_green and in_session

// ============ Position Management ============
if buy_signal and strategy.position_size == 0
    entry_price = close
    sl_price = supertrend
    risk = entry_price - sl_price
    tp_price = entry_price + (risk * rr_ratio)

    strategy.entry("Long", strategy.long)
    strategy.exit("TP/SL", "Long", stop=sl_price, limit=tp_price)

// ============ Visualization ============
plot(supertrend, "SuperTrend", color=is_uptrend ? color.green : color.red, linewidth=2)
plot(final_ub, "ST Upper Band", color=color.new(color.gray, 50), linewidth=1)
plot(final_lb, "ST Lower Band", color=color.new(color.gray, 50), linewidth=1)

// Alert conditions (optional - for notifications)
alertcondition(buy_signal, title="ST33 Buy Signal", message="SuperTrend flip bullish + daily green in US session")
